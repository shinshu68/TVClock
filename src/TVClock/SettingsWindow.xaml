<Window x:Class="TVClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVClock の設定"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="文字サイズ(_F)" Target="{Binding ElementName=FontSizeSlider}" />
        <Slider x:Name="FontSizeSlider" Grid.Row="0" Grid.Column="1"
                Margin="8,0" VerticalAlignment="Center"
                IsSnapToTickEnabled="True" />
        <TextBlock x:Name="FontSizeText" Grid.Row="0" Grid.Column="2"
                   VerticalAlignment="Center" TextAlignment="Right" />

        <Label Grid.Row="1" Grid.Column="0" Content="背景の濃さ(_B)" Target="{Binding ElementName=BackgroundOpacitySlider}" />
        <Slider x:Name="BackgroundOpacitySlider" Grid.Row="1" Grid.Column="1"
                Margin="8,0" VerticalAlignment="Center"
                IsSnapToTickEnabled="True" />
        <TextBlock x:Name="BackgroundOpacityText" Grid.Row="1" Grid.Column="2"
                   VerticalAlignment="Center" TextAlignment="Right" />

        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Content="閉じる" IsCancel="True" IsDefault="True"
                Width="88" Margin="0,16,0,0" HorizontalAlignment="Right"
                Click="OnCloseClick" />
    </Grid>
</Window>
