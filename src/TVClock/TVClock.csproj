<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WPF にはタスクトレイのアイコンがないため、Windows Forms の NotifyIcon を使う -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- ico は tools/New-AppIcon.ps1 で生成する -->
    <ApplicationIcon>Assets\TVClock.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\TVClock.ico" LogicalName="TVClock.ico" />
  </ItemGroup>

  <PropertyGroup>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- 配布物が exe だけになるよう、デバッグ情報は exe に埋め込む -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- WPF と同じ名前の型 (Application・Point・Size など) がぶつかるため、Windows Forms 側は暗黙の using から外す -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
