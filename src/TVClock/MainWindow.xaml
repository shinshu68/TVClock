<Window x:Class="TVClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TVClock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="40" Top="40">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ClickThroughMenuItem" Header="クリックスルー(_C)" Click="OnClickThroughClick" />
            <MenuItem x:Name="AutoStartMenuItem" Header="Windows の起動時に実行(_A)" Click="OnAutoStartClick" />
            <MenuItem Header="設定(_S)..." Click="OnSettingsClick" />
            <Separator />
            <MenuItem Header="終了(_X)" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>
    <!-- 完全に透明な部分はマウス操作が下のウィンドウへ抜けるため、背景を消しても時計をつかめるよう、ごく薄い色を敷く -->
    <Border x:Name="ClockRoot" Background="#01000000">
        <!-- 文字サイズと背景の不透明度は、起動時に設定の値で上書きする。文字色は白で固定し、フォントは指定せず Windows の既定のものを使う -->
        <Border>
            <Border.Background>
                <SolidColorBrush x:Name="BackgroundBrush" Color="Black" Opacity="0" />
            </Border.Background>
            <TextBlock x:Name="TimeText"
                       Foreground="White"
                       FontSize="96" />
        </Border>
    </Border>
</Window>
